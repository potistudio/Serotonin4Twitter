{
  "manifest_version": 3,
  "name": "Serotonin for Twitter",
  "version": "1.0.0",
  "description": "Twitterのタイムラインを、スクロールではなく1枚ずつのカードで表示します。",
  "permissions": [ "storage" ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [ "content.js" ],
      "css": [ "content.css" ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Serotonin for Twitter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
